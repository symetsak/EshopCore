@page "/change-password"
@layout Layout.EmptyLayout
@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@attribute [AllowAnonymous]

<MudDrawer @bind-Open="@_isWelcomeDrawerOpen"
           Anchor="Anchor.Left"
           Elevation="5"
           Variant="@DrawerVariant.Persistent"
           Width="360px"
           Style="border-top-right-radius: 20px; border-bottom-right-radius: 20px; padding: 28px; background-color: #ffffff; height: 100vh; border-right: 2px solid var(--mud-palette-warning);">

    <div class="text-center mb-5">
        <MudIcon Icon="@Icons.Material.Filled.WavingHand" Color="Color.Warning" Size="Size.Large" Style="font-size: 3rem;" />
        <MudText Typo="Typo.h5" Class="font-weight-bold mt-2" Color="Color.Warning">Καλωσήρθατε!</MudText>
    </div>

    <MudText Typo="Typo.body1" Class="mb-5 text-justify" Style="color: #222; line-height: 1.7; font-size: 1.05rem;">
        Καλωσήρθατε στην ομάδα του <b>@TenantName</b>!
        <br /><br />
        Παρακαλώ στο επόμενο βήμα δημιουργήστε τον δικό σας προσωπικό κωδικό πρόσβασης.
    </MudText>

    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-6 pa-3" Style="border-radius: 8px;">
        Στο πεδίο <b>"Τρέχων Κωδικός"</b> πληκτρολογήστε: <br />
        <span class="font-weight-bold" style="font-family: monospace; font-size: 1.15rem; letter-spacing: 1px;">Welcome123!</span>
    </MudAlert>

    <MudButton Variant="Variant.Filled"
               Color="Color.Warning"
               FullWidth="true"
               Size="Size.Large"
               OnClick="CloseWelcomeDrawer"
               Style="border-radius: 8px; height: 48px; font-weight: bold;">
        Κατανόηση
    </MudButton>
</MudDrawer>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width:100%; max-width:400px; border-radius:16px;">

        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" Size="Size.Large" Class="mb-2" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h5" Class="font-weight-bold">Αλλαγή Κωδικού</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Ορίστε τον νέο κωδικό πρόσβασης του λογαριασμού σας</MudText>
        </div>

        <EditForm Model="@_model" OnValidSubmit="HandleChangePassword">
            <DataAnnotationsValidator />

            <MudTextField Label="Όνομα Καταστήματος (Slug)" @bind-Value="_model.TenantId" For="@(() => _model.TenantId)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField Label="Όνομα Χρήστη (Username)" @bind-Value="_model.Username" For="@(() => _model.Username)" Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField Label="Τωρινός Κωδικός" @bind-Value="_model.CurrentPassword" For="@(() => _model.CurrentPassword)"
                          InputType="@_currentPasswordInput" Variant="Variant.Outlined" Class="mb-3"
                          Adornment="Adornment.End" AdornmentIcon="@_currentPasswordIcon" OnAdornmentClick="ToggleCurrentPassword" />

            <MudTextField Label="Νέος Κωδικός" @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)"
                          InputType="@_newPasswordInput" Variant="Variant.Outlined" Class="mb-3"
                          Adornment="Adornment.End" AdornmentIcon="@_newPasswordIcon" OnAdornmentClick="ToggleNewPassword" />

            <MudTextField Label="Επιβεβαίωση Νέου Κωδικού" @bind-Value="_model.ConfirmNewPassword" For="@(() => _model.ConfirmNewPassword)"
                          InputType="@_confirmPasswordInput" Variant="Variant.Outlined" Class="mb-6"
                          Adornment="Adornment.End" AdornmentIcon="@_confirmPasswordIcon" OnAdornmentClick="ToggleConfirmPassword" />

            @if (!string.IsNullOrEmpty(_message))
            {
                <MudAlert Severity="@_messageSeverity" Variant="Variant.Filled" Class="mb-4 pa-2">@_message</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Size="Size.Large" Disabled="@_isSubmitting" Style="border-radius:8px; height: 48px;">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Ενημέρωση...</MudText>
                }
                else
                {
                    <MudText>Ενημέρωση Κωδικού</MudText>
                }
            </MudButton>

            <div class="text-center mt-4">
                <MudLink Href="/login" Typo="Typo.body2">Επιστροφή στο Login</MudLink>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    // Χρησιμοποιούμε πλέον το IAuthService αντί για HttpClient
    [Inject] private IAuthService AuthService { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    // ΠΡΟΣΘΕΤΑ PARAMETERS ΓΙΑ ΤΗ ΔΥΝΑΜΙΚΗ ΛΕΙΤΟΥΡΓΙΑ ΑΡΙΣΤΕΡΟΥ POP-UP
    [Parameter]
    [SupplyParameterFromQuery(Name = "tenant")]
    public string? TenantName { get; set; }

    private bool _isWelcomeDrawerOpen = false;

    private ChangePasswordModel _model = new();
    private string _message = string.Empty;
    private Severity _messageSeverity = Severity.Error;
    private bool _isSubmitting = false;

    // ΜΕΤΑΒΛΗΤΕΣ ΓΙΑ ΤΑ 3 ΜΑΤΑΚΙΑ
    private bool _showCurrent = false;
    private InputType _currentPasswordInput = InputType.Password;
    private string _currentPasswordIcon = Icons.Material.Filled.VisibilityOff;

    private bool _showNew = false;
    private InputType _newPasswordInput = InputType.Password;
    private string _newPasswordIcon = Icons.Material.Filled.VisibilityOff;

    private bool _showConfirm = false;
    private InputType _confirmPasswordInput = InputType.Password;
    private string _confirmPasswordIcon = Icons.Material.Filled.VisibilityOff;

    // ΑΥΤΟΜΑΤΗ ΕΝΕΡΓΟΠΟΙΗΣΗ ΚΑΙ ΠΡΟ-ΣΥΜΠΛΗΡΩΣΗ ΣΤΗΝ ΕΚΚΙΝΗΣΗ
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(TenantName))
        {
            _isWelcomeDrawerOpen = true;
            _model.TenantId = TenantName; // Συμπληρώνουμε αυτόματα το Tenant ID στη φόρμα για ευκολία
        }
    }

    private void CloseWelcomeDrawer()
    {
        _isWelcomeDrawerOpen = false;
    }

    // ΜΕΘΟΔΟΙ ΓΙΑ ΤΟ TOGGLE ΚΑΘΕ ΠΕΔΙΟΥ
    private void ToggleCurrentPassword()
    {
        _showCurrent = !_showCurrent;
        _currentPasswordInput = _showCurrent ? InputType.Text : InputType.Password;
        _currentPasswordIcon = _showCurrent ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private void ToggleNewPassword()
    {
        _showNew = !_showNew;
        _newPasswordInput = _showNew ? InputType.Text : InputType.Password;
        _newPasswordIcon = _showNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private void ToggleConfirmPassword()
    {
        _showConfirm = !_showConfirm;
        _confirmPasswordInput = _showConfirm ? InputType.Text : InputType.Password;
        _confirmPasswordIcon = _showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleChangePassword()
    {
        _isSubmitting = true;
        _message = string.Empty;

        try
        {
            // Η κλήση γίνεται πλέον μέσα από το Service. Όλη η λογική του Http Request κρύβεται!
            var response = await AuthService.ChangePasswordAsync(_model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Ο κωδικός άλλαξε επιτυχώς!", Severity.Success);
                NavManager.NavigateTo("/login");
            }
            else
            {
                _messageSeverity = Severity.Error;
                _message = "Αποτυχία αλλαγής. Ελέγξτε αν ο τωρινός κωδικός είναι σωστός.";
            }
        }
        catch (Exception ex)
        {
            _messageSeverity = Severity.Error;
            _message = $"Σφάλμα δικτύου: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}