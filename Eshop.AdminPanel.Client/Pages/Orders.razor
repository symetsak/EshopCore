@page "/admin/orders"
@attribute [Authorize(Roles = "Administrator, Employee")]
@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@using System.Net.Http.Json
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-5 font-weight-bold">Διαχείριση Παραγγελιών</MudText>

    <MudTable T="OrderUIModel" ServerData="ServerReload" Dense="false" Hover="true" Striped="true" Elevation="2" @ref="_table">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_searchString" Placeholder="Αναζήτηση ID, Πελάτη, Email..."
                          Immediate="true" DebounceInterval="500"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Clearable="true" />
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFilters" Class="ml-4">
                Καθαρισμός
            </MudButton>
            <MudMenu Label="Εξαγωγή" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download" Class="ml-4" Disabled="@_isExporting">
                <MudMenuItem OnClick="ExportToExcel" Icon="@Icons.Material.Filled.TableChart">ως Excel (.xlsx)</MudMenuItem>
                <MudMenuItem OnClick="ExportToPdf" Icon="@Icons.Material.Filled.PictureAsPdf">ως PDF (.pdf)</MudMenuItem>
            </MudMenu>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudIcon Icon="@Icons.Material.Filled.ExpandMore" Style="opacity: 0;" /></MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="id" T="OrderUIModel">ID</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <div class="d-flex align-center">
                    <MudTableSortLabel SortLabel="date" T="OrderUIModel">Ημερομηνία</MudTableSortLabel>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                        <div class="pa-4" style="width: 250px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Διάστημα Ημερομηνιών</MudText>
                            <MudDatePicker Label="Από" DateChanged="OnMinDateChanged" Clearable="true" DateFormat="dd/MM/yyyy" Class="mb-2" />
                            <MudDatePicker Label="Έως" DateChanged="OnMaxDateChanged" Clearable="true" DateFormat="dd/MM/yyyy" />
                        </div>
                    </MudMenu>
                </div>
            </MudTh>
            <MudTh>Πελάτης</MudTh> 
            <MudTh>
                <MudTableSortLabel SortLabel="amount" T="OrderUIModel">Σύνολο</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <div class="d-flex align-center">
                    Πληρωμή
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                        <div class="pa-4" style="width: 250px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Φίλτρο Πληρωμής</MudText>
                            <MudSelect T="string" MultiSelection="true" SelectedValuesChanged="OnPaymentMethodsChanged" Clearable="true" Dense="true" Placeholder="Όλα">
                                <MudSelectItem T="string" Value="@("Card")">Κάρτα (Card)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CashOnDelivery")">Αντικαταβολή</MudSelectItem>
                            </MudSelect>
                        </div>
                    </MudMenu>
                </div>
            </MudTh>
            <MudTh>
                <div class="d-flex align-center">
                    Κατάσταση
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                        <div class="pa-4" style="width: 250px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Φίλτρο Κατάστασης</MudText>
                            <MudSelect T="string" MultiSelection="true" SelectedValuesChanged="OnStatusesChanged" Clearable="true" Dense="true" Placeholder="Όλα">
                                <MudSelectItem T="string" Value="@("Pending")">Pending</MudSelectItem>
                                <MudSelectItem T="string" Value="@("PendingPayment")">Pending Payment</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Paid")">Paid</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Shipped")">Shipped</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Completed")">Completed</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Cancelled")">Cancelled</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Refunded")">Refunded</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CancellationRequested")">Cancel Requested</MudSelectItem>
                            </MudSelect>
                        </div>
                    </MudMenu>
                </div>
            </MudTh>
            <MudTh Style="width: 220px;">Ενημέρωση</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudIconButton Icon="@(context.ShowDetails ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="@(() => context.ShowDetails = !context.ShowDetails)"
                               Size="Size.Small" Color="Color.Primary" />
            </MudTd>
            <MudTd DataLabel="ID"><b>#@context.Id</b></MudTd>
            <MudTd DataLabel="Ημερομηνία">@context.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>

            <!-- Εμφάνιση Ονόματος & ID Πελάτη -->
            <MudTd DataLabel="Πελάτης">
                <div>
                    <b>@(!string.IsNullOrEmpty(context.CustomerName) ? context.CustomerName : "Πελάτης")</b>
                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">ID: #@context.CustomerId</MudText>
                </div>
            </MudTd>

            <MudTd DataLabel="Σύνολο"><b>@context.TotalAmount.ToString("C")</b></MudTd>
            <MudTd DataLabel="Πληρωμή">
                <MudIcon Icon="@(context.PaymentMethod == "Card" ? Icons.Material.Filled.CreditCard : Icons.Material.Filled.LocalShipping)" Size="Size.Small" Class="mr-1" />
                @context.PaymentMethod
            </MudTd>
            <MudTd DataLabel="Κατάσταση">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                    @context.Status
                </MudChip>
            </MudTd>

            <!-- Έλεγχος Δυναμικών Επιλογών Dropdown -->
            <MudTd DataLabel="Ενημέρωση">
                @{
                    // Περνάμε και το PaymentMethod στη μέθοδο
                    var availableStatuses = GetAvailableStatuses(context.Status, context.PaymentMethod);
                }

                @if (availableStatuses.Any())
                {
                    <MudSelect T="string" Value="@context.Status" ValueChanged="@((s) => UpdateStatusAsync(context.Id, s))"
                               Dense="true" Outlined="true" Margin="Margin.Dense" DisableUnderLine="true">
                        <MudSelectItem Value="@context.Status">@context.Status</MudSelectItem>

                        @foreach (var status in availableStatuses)
                        {
                            <MudSelectItem Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <!-- Αν η λίστα είναι άδεια (π.χ. Cancelled με CashOnDelivery ή Completed/Refunded), κλειδώνει -->
                    <MudSelect T="string" Value="@context.Status" Disabled="true" Dense="true" Outlined="true" Margin="Margin.Dense">
                        <MudSelectItem Value="@context.Status">@context.Status</MudSelectItem>
                    </MudSelect>
                }
            </MudTd>
        </RowTemplate>

        <ChildRowContent>
            @if (context.ShowDetails)
            {
                <MudTr>
                    <td colspan="8">
                        <MudCard Elevation="0" Class="pa-4 my-2" Style="background-color: var(--mud-palette-background-grey); border-left: 4px solid var(--mud-palette-primary);">
                            <MudGrid>
                                <!-- 🛒 ΑΡΙΣΤΕΡΑ: ΠΕΡΙΕΧΟΜΕΝΑ ΠΑΡΑΓΓΕΛΙΑΣ (6/12) -->
                                <MudItem xs="12" md="6">
                                    <MudText Typo="Typo.subtitle2" Class="mb-3 font-weight-bold">Περιεχόμενα Παραγγελίας</MudText>

                                    <MudTable Items="@context.OrderItems" Context="itemContext" Dense="true" Hover="false" Elevation="0" Outlined="true">
                                        <HeaderContent>
                                            <MudTh>ID</MudTh>
                                            <MudTh>Προϊόν</MudTh>
                                            <MudTh>Τιμή</MudTh>
                                            <MudTh>Ποσ.</MudTh>
                                            <MudTh>Υποσύνολο</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="ID">@itemContext.ProductId</MudTd>
                                            <MudTd DataLabel="Προϊόν">@itemContext.ProductName</MudTd>
                                            <MudTd DataLabel="Τιμή">@itemContext.UnitPrice.ToString("C")</MudTd>
                                            <MudTd DataLabel="Ποσότητα">x @itemContext.Quantity</MudTd>
                                            <MudTd DataLabel="Υποσύνολο"><b>@((itemContext.Quantity * itemContext.UnitPrice).ToString("C"))</b></MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudItem>

                                <!-- ΔΕΞΙΑ: ΔΙΕΥΘΥΝΣΗ & ΕΠΙΚΟΙΝΩΝΙΑ (6/12) -->
                                <MudItem xs="12" md="6">
                                    <MudGrid>
                                        <!-- 1. Στοιχεία Διεύθυνσης -->
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Class="pa-3 h-100" Outlined="true" Style="background-color: var(--mud-palette-surface);">
                                                <div class="d-flex align-center mb-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Error" Class="mr-2" Size="Size.Small" />
                                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Στοιχεία Διεύθυνσης</MudText>
                                                </div>
                                                <MudDivider Class="mb-3" />

                                                @if (!string.IsNullOrEmpty(context.Street) || !string.IsNullOrEmpty(context.City))
                                                {
                                                    <div class="d-flex flex-column gap-1">
                                                        <MudText Typo="Typo.body2">
                                                            <b>Οδός/Αριθμός:</b> @context.Street @context.StreetNumber
                                                        </MudText>
                                                        <MudText Typo="Typo.body2">
                                                            <b>Πόλη:</b> @context.City
                                                        </MudText>
                                                        <MudText Typo="Typo.body2">
                                                            <b>Τ.Κ.:</b> @context.ZipCode
                                                        </MudText>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                        Δεν υπάρχουν διαθέσιμα στοιχεία διεύθυνσης.
                                                    </MudText>
                                                }
                                            </MudPaper>
                                        </MudItem>

                                        <!-- 2. Στοιχεία Επικοινωνίας -->
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Class="pa-3 h-100" Outlined="true" Style="background-color: var(--mud-palette-surface);">
                                                <div class="d-flex align-center mb-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.ContactPhone" Color="Color.Primary" Class="mr-2" Size="Size.Small" />
                                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Στοιχεία Επικοινωνίας</MudText>
                                                </div>
                                                <MudDivider Class="mb-3" />

                                                <div class="d-flex flex-column gap-1">
                                                    <MudText Typo="Typo.body2" Class="text-truncate">
                                                        <b>Email:</b> <a href="mailto:@context.CustomerEmail" style="text-decoration: none; color: var(--mud-palette-primary);">@(!string.IsNullOrEmpty(context.CustomerEmail) ? context.CustomerEmail : "-")</a>
                                                    </MudText>
                                                    <MudText Typo="Typo.body2">
                                                        <b>Τηλέφωνο:</b> <a href="tel:@context.CustomerPhone" style="text-decoration: none; color: inherit;">@(!string.IsNullOrEmpty(context.CustomerPhone) ? context.CustomerPhone : "-")</a>
                                                    </MudText>
                                                </div>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    </td>
                </MudTr>
            }
        </ChildRowContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Παραγγελίες ανά σελίδα:" InfoFormat="{first_item}-{last_item} από {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<OrderUIModel> _table = null!;
    private string _searchString = "";

    // Νέα μεταβλητά πεδία για τα φίλτρα
    private DateTime? _minDate;
    private DateTime? _maxDate;
    private IEnumerable<string> _selectedStatuses = new HashSet<string>();
    private IEnumerable<string> _selectedPaymentMethods = new HashSet<string>();
    private bool _isExporting = false;
    private string? _currentSortBy;

    private void OnSearch(string text)
    {
        _searchString = text;
        _table.ReloadServerData();
    }

    private void OnMinDateChanged(DateTime? date)
    {
        _minDate = date;
        _table.ReloadServerData();
    }

    private void OnMaxDateChanged(DateTime? date)
    {
        _maxDate = date;
        _table.ReloadServerData();
    }

    private void OnStatusesChanged(IEnumerable<string> statuses)
    {
        _selectedStatuses = statuses;
        _table.ReloadServerData();
    }

    private void OnPaymentMethodsChanged(IEnumerable<string> methods)
    {
        _selectedPaymentMethods = methods;
        _table.ReloadServerData();
    }

    private async Task<TableData<OrderUIModel>> ServerReload(TableState state, System.Threading.CancellationToken cancellationToken)
    {
        try
        {
            var pageNumber = state.Page + 1;
            var pageSize = state.PageSize;

            _currentSortBy = null;
            if (!string.IsNullOrEmpty(state.SortLabel))
            {
                _currentSortBy = state.SortDirection == SortDirection.Descending
                    ? $"{state.SortLabel}_desc"
                    : state.SortLabel;
            }

            var data = await OrderService.GetPagedOrdersAsync(
                pageNumber,
                pageSize,
                _searchString,
                _minDate,
                _maxDate,
                _selectedStatuses.ToList(),
                _selectedPaymentMethods.ToList(),
                _currentSortBy 
            );

            if (data != null)
            {
                // Map από το DTO στο UI Model για να υποστηρίζει το ShowDetails
                var mappedItems = data.Items.Select(o => new OrderUIModel
                {
                    Id = o.Id,
                    OrderDate = o.OrderDate,
                    TotalAmount = o.TotalAmount,
                    Status = o.Status,
                    CustomerId = o.CustomerId,
                    CustomerName = o.CustomerName,
                    PaymentMethod = o.PaymentMethod,
                    OrderItems = o.OrderItems,
                    Street = o.Street,
                    StreetNumber = o.StreetNumber,
                    City = o.City,
                    ZipCode = o.ZipCode,
                    CustomerEmail = o.CustomerEmail,
                    CustomerPhone = o.CustomerPhone,
                    ShowDetails = false // Default κλειστό
                }).ToList();

                return new TableData<OrderUIModel>
                {
                    TotalItems = data.TotalCount,
                    Items = mappedItems
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα φόρτωσης παραγγελιών: {ex.Message}", Severity.Error);
        }

        return new TableData<OrderUIModel>() { Items = new List<OrderUIModel>(), TotalItems = 0 };
    }

    private async Task UpdateStatusAsync(int orderId, string newStatus)
    {
        // Αν ο χρήστης ξαναεπέλεξε το ίδιο status, δεν κάνουμε API call (Για το update state διαβάζουμε απ' ευθείας απ' το table logic)
        try
        {
            // Κλήση στο Service
            var response = await OrderService.UpdateOrderStatusAsync(orderId, newStatus);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Η παραγγελία #{orderId} άλλαξε σε {newStatus}!", Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Snackbar.Add(errorResult?.Message ?? "Προέκυψε σφάλμα κατά την ενημέρωση.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Εξαίρεση: {ex.Message}", Severity.Error);
        }
    }

    // ΚΑΝΟΝΕΣ ΔΥΝΑΜΙΚΗΣ ΕΜΦΑΝΙΣΗΣ STATUS ΣΤΟ DROPDOWN
    private List<string> GetAvailableStatuses(string currentStatus, string paymentMethod)
    {
        return currentStatus switch
        {
            // Αν είναι Pending ή Paid -> Επιτρέπει Shipped & Completed
            "Pending" or "Paid" => new List<string> { "Shipped", "Completed" },

            // Αν είναι CancellationRequested -> Επιτρέπει Cancelled & Refunded
            "CancellationRequested" => new List<string> { "Cancelled", "Refunded" },

            // Αν είναι Shipped -> Επιτρέπει μετάβαση σε Completed
            "Shipped" => new List<string> { "Completed" },

            // - Αν πληρώθηκε με Card -> Επιτρέπει ΜΟΝΟ τη μετάβαση σε Refunded
            // - Αν πληρώθηκε με CashOnDelivery -> Επιστρέφει άδεια λίστα (κλειδώνει)
            "Cancelled" => paymentMethod.Equals("Card", StringComparison.OrdinalIgnoreCase)
                ? new List<string> { "Refunded" }
                : new List<string>(),

            // Σε οποιαδήποτε άλλη περίπτωση (Completed, Refunded, κτλ.) κλειδώνει
            _ => new List<string>()
        };
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Pending" or "PendingPayment" => Color.Warning,
        "Paid" => Color.Info,
        "Shipped" => Color.Primary,
        "Completed" => Color.Success,
        "Cancelled" or "Refunded" => Color.Error,
        "CancellationRequested" => Color.Dark,
        _ => Color.Default
    };

    // Μπορείς να μεταφέρεις αυτή την κλάση στο AppModels.cs!
    public class OrderUIModel : OrderResponseDto{}

    private void ClearFilters()
    {
        _searchString = "";
        _minDate = null;
        _maxDate = null;
        _selectedStatuses = new HashSet<string>();
        _selectedPaymentMethods = new HashSet<string>();
        _table.ReloadServerData();
    }

    // Οι μέθοδοι Εξαγωγής (Excel / PDF)
    private async Task ExportToExcel()
    {
        _isExporting = true;
        StateHasChanged(); // Ανανέωση UI για να γίνει disabled το κουμπί

        try
        {
            var fileBytes = await OrderService.ExportOrdersExcelAsync(
                _searchString, _minDate, _maxDate, _selectedStatuses.ToList(), _selectedPaymentMethods.ToList(), _currentSortBy);

            using var streamRef = new DotNetStreamReference(new MemoryStream(fileBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Orders_Export_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", streamRef);

            Snackbar.Add("Η εξαγωγή σε Excel ολοκληρώθηκε!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Αποτυχία εξαγωγής: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportToPdf()
    {
        _isExporting = true;
        StateHasChanged();

        try
        {
            var fileBytes = await OrderService.ExportOrdersPdfAsync(
                _searchString, _minDate, _maxDate, _selectedStatuses.ToList(), _selectedPaymentMethods.ToList(), _currentSortBy);

            using var streamRef = new DotNetStreamReference(new MemoryStream(fileBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Orders_Export_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);

            Snackbar.Add("Η εξαγωγή σε PDF ολοκληρώθηκε!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Αποτυχία εξαγωγής: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }
}