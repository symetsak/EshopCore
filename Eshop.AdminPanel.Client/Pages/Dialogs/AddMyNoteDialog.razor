@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddComment" Class="mr-2" />
            Νέα Παρατήρηση
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_newNote" Label="Γράψτε την παρατήρησή σας (π.χ. τιμολόγηση, άδεια κτλ)..." Variant="Variant.Outlined" Lines="3" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Ακύρωση</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SubmitNote" Disabled="@(string.IsNullOrWhiteSpace(_newNote) || _isSaving)">
            Αποθήκευση
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private string _newNote = string.Empty;
    private bool _isSaving = false;

    private async Task SubmitNote()
    {
        _isSaving = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "api/Users/my-notes");
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var tenantId = await LocalStorage.GetItemAsync<string>("tenantId");

            if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);

            request.Content = JsonContent.Create(_newNote);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Η παρατήρηση προστέθηκε με επιτυχία!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Σφάλμα: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}