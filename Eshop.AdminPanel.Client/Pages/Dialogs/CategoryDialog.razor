@using System.Net.Http.Headers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(IsEdit ? "Επεξεργασία Κατηγορίας" : "Προσθήκη Νέας Κατηγορίας")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem XS="12">
                    <MudTextField Label="Όνομα Κατηγορίας" @bind-Value="_model.Name"
                                  For="@(() => _model.Name)" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12">
                    <MudNumericField T="int" Label="Σειρά Εμφάνισης" @bind-Value="_model.DisplayOrder"
                                     Min="1" Required="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleSubmit" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Αποθήκευση...</span>
            }
            else
            {
                <span>Αποθήκευση</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // Δεχόμαστε την κατηγορία. Αν είναι null -> Create, αν έχει τιμή -> Edit (PUT)
    [Parameter] public Products.CategoryDto? CategoryToEdit { get; set; }

    private CategoryModel _model = new();
    private bool _isSaving = false;
    private bool IsEdit => CategoryToEdit != null;

    protected override void OnInitialized()
    {
        if (IsEdit && CategoryToEdit != null)
        {
            _model = new CategoryModel
            {
                Name = CategoryToEdit.Name,
                DisplayOrder = CategoryToEdit.DisplayOrder
            };
        }
        else
        {
            _model.DisplayOrder = 1;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Παρακαλώ εισάγετε όνομα κατηγορίας.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            HttpResponseMessage response;
            var tenantId = await LocalStorage.GetItemAsync<string>("tenantId");
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (IsEdit)
            {
                // PUT api/Categories/{id}
                var request = new HttpRequestMessage(HttpMethod.Put, $"api/Categories/{CategoryToEdit!.Id}");
                request.Content = JsonContent.Create(_model);

                if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);
                if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                response = await Http.SendAsync(request);
            }
            else
            {
                // POST api/Categories
                var request = new HttpRequestMessage(HttpMethod.Post, "api/Categories");
                request.Content = JsonContent.Create(_model);

                if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);
                if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                response = await Http.SendAsync(request);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(IsEdit ? "Η κατηγορία ενημερώθηκε επιτυχώς!" : "Η κατηγορία δημιουργήθηκε επιτυχώς!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Αποτυχία αποθήκευσης: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public class CategoryModel
    {
        public string Name { get; set; } = string.Empty;
        public int DisplayOrder { get; set; }
    }
}