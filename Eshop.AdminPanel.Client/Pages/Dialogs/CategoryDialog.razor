@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@inject ICategoryService CategoryService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(IsEdit ? "Επεξεργασία Κατηγορίας" : "Προσθήκη Νέας Κατηγορίας")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem XS="12">
                    <MudTextField Label="Όνομα Κατηγορίας" @bind-Value="_model.Name"
                                  For="@(() => _model.Name)" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12">
                    <MudNumericField T="int" Label="Σειρά Εμφάνισης" @bind-Value="_model.DisplayOrder"
                                     Min="1" Required="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleSubmit" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Αποθήκευση...</span>
            }
            else
            {
                <span>Αποθήκευση</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // Δεχόμαστε την κατηγορία. Αν είναι null -> Create, αν έχει τιμή -> Edit (PUT)
    [Parameter] public CategoryDto? CategoryToEdit { get; set; }

    private CategoryModel _model = new();
    private bool _isSaving = false;
    private bool IsEdit => CategoryToEdit != null;

    protected override void OnInitialized()
    {
        if (IsEdit && CategoryToEdit != null)
        {
            _model = new CategoryModel
            {
                Name = CategoryToEdit.Name,
                DisplayOrder = CategoryToEdit.DisplayOrder
            };
        }
        else
        {
            _model.DisplayOrder = 1;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Παρακαλώ εισάγετε όνομα κατηγορίας.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            HttpResponseMessage response;

            if (IsEdit)
            {
                // PUT: Ενημέρωση μέσω του Service. Τα tokens μπαίνουν αυτόματα.
                response = await CategoryService.UpdateCategoryAsync(CategoryToEdit!.Id, _model);
            }
            else
            {
                // POST: Δημιουργία μέσω του Service.
                response = await CategoryService.CreateCategoryAsync(_model);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(IsEdit ? "Η κατηγορία ενημερώθηκε επιτυχώς!" : "Η κατηγορία δημιουργήθηκε επιτυχώς!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Αποτυχία αποθήκευσης: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}