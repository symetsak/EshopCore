@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="mr-2" />
            Εφαρμογή Προσφοράς: @Product.Name
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            Αρχική Τιμή Προϊόντος: <span class="font-weight-bold">@Product.OriginalPrice.ToString("C2")</span>
        </MudText>

        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem XS="12">
                    <MudRadioGroup @bind-Value="_discountType" T="string">
                        <MudRadio Value="@("percentage")" Color="Color.Primary">Ποσοστό Έκπτωσης (%)</MudRadio>
                        <MudRadio Value="@("price")" Color="Color.Primary">Απευθείας Τιμή Προσφοράς (€)</MudRadio>
                    </MudRadioGroup>
                </MudItem>

                @if (_discountType == "percentage")
                {
                    <MudItem XS="12">
                        <MudNumericField T="int?" Label="Ποσοστό Έκπτωσης (%)" @bind-Value="_model.DiscountPercentage"
                                         Min="1" Max="99" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="%" />
                    </MudItem>
                }
                else
                {
                    <MudItem XS="12">
                        <MudNumericField T="decimal?" Label="Νέα Τιμή Προσφοράς (€)" @bind-Value="_model.SalePrice"
                                         Min="0.01m" Format="N2" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="€" />
                    </MudItem>
                }

                <MudItem XS="12" SM="6">
                    <MudDatePicker Label="Έναρξη Προσφοράς" @bind-Date="_model.SaleStartDate"
                                   Variant="Variant.Outlined" Editable="true" Clearable="true" />
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudDatePicker Label="Λήξη Προσφοράς" @bind-Date="_model.SaleEndDate"
                                   Variant="Variant.Outlined" Editable="true" Clearable="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        @if (Product.SalePrice.HasValue)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.RotateLeft"
                       OnClick="ResetDiscount"
                       Class="px-4">
                ΕΠΑΝΑΦΟΡΑ ΤΙΜΗΣ
            </MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel">ΑΚΥΡΩΣΗ</MudButton>
        <MudButton OnClick="HandleSubmit" Variant="Variant.Filled" Color="Color.Warning">ΕΦΑΡΜΟΓΗ ΠΡΟΣΦΟΡΑΣ</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ProductResponseModel Product { get; set; } = null!;

    private UpdateProductDiscountModel _model = new();
    private string _discountType = "percentage"; // Default επιλογή
    private bool _isSaving = false;

    protected override void OnInitialized()
    {
        // Αν το προϊόν έχει ήδη SalePrice, προτείνουμε απευθείας τιμή
        if (Product.SalePrice.HasValue)
        {
            _discountType = "price";
            _model.SalePrice = Product.SalePrice;
            _model.SaleStartDate = Product.SaleStartDate;
            _model.SaleEndDate = Product.SaleEndDate;
        }
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        try
        {
            // Καθαρίζουμε το πεδίο που δεν επιλέχθηκε για να μην μπερδευτεί το API
            if (_discountType == "percentage")
            {
                _model.SalePrice = null;
                if (!_model.DiscountPercentage.HasValue || _model.DiscountPercentage <= 0)
                {
                    Snackbar.Add("Παρακαλώ εισάγετε ένα έγκυρο ποσοστό έκπτωσης.", Severity.Warning);
                    _isSaving = false;
                    return;
                }
            }
            else
            {
                _model.DiscountPercentage = null;
                if (!_model.SalePrice.HasValue || _model.SalePrice <= 0 || _model.SalePrice >= Product.OriginalPrice)
                {
                    Snackbar.Add("Η τιμή προσφοράς πρέπει να είναι μικρότερη από την αρχική τιμή.", Severity.Warning);
                    _isSaving = false;
                    return;
                }
            }

            // Κλήση στο API: PUT api/Products/{id}/discounts
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/Products/{Product.Id}/discounts");
            request.Content = JsonContent.Create(_model);

            var tenantId = await LocalStorage.GetItemAsync<string>("tenantId");
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);
            if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Η προσφορά εφαρμόστηκε με επιτυχία! Οι χρήστες που έχουν το προϊόν στη Wishlist θα ειδοποιηθούν.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Αποτυχία εφαρμογής προσφοράς: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task ResetDiscount()
    {
        try
        {
            // Χτυπάμε το ολοκαίνουριο DELETE endpoint!
            var url = $"api/Products/{Product.Id}/discounts";
            var request = new HttpRequestMessage(HttpMethod.Delete, url);

            var tenantId = await LocalStorage.GetItemAsync<string>("tenantId");
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);
            if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                // Ενημερώνουμε το UI αμέσως
                Product.SalePrice = null;
                Product.SaleStartDate = null;
                Product.SaleEndDate = null;
                Product.Price = Product.OriginalPrice;

                Snackbar.Add("Η προσφορά αφαιρέθηκε επιτυχώς!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Αποτυχία επαναφοράς: {errorContent}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
    }
}