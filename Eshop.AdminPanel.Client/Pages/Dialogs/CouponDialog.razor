@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@inject ICouponService CouponService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.LocalOffer)" Class="mr-2" />
            @(IsEdit ? "Επεξεργασία Κουπονιού" : "Δημιουργία Νέου Κουπονιού")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem XS="12" SM="6">
                    <MudTextField Label="Κωδικός Κουπονιού (π.χ. SUMMER20)" @bind-Value="_model.Code"
                                  Required="true" Variant="Variant.Outlined" Style="text-transform: uppercase;" />
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudSelect T="string" Label="Τύπος Έκπτωσης" @bind-Value="_model.DiscountType" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("Percentage")">Ποσοστό (%)</MudSelectItem>
                        <MudSelectItem Value="@("FixedAmount")">Σταθερό Ποσό (€)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudNumericField T="decimal" Label="Αξία Έκπτωσης" @bind-Value="_model.DiscountValue"
                                     Format="N2" Min="0.01m" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudNumericField T="decimal" Label="Ελάχιστο Ποσό Καλαθιού (€)" @bind-Value="_model.MinimumSubTotalRequired"
                                     Format="N2" Min="0" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudDatePicker Label="Ημερομηνία Έναρξης" @bind-Date="_model.StartDate" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12" SM="6">
                    <MudDatePicker Label="Ημερομηνία Λήξης" @bind-Date="_model.EndDate" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem XS="12">
                    <MudSwitch @bind-Value="_model.IsActive" Color="Color.Success" Label="Ενεργό Κουπόνι" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleSubmit" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Αποθήκευση...</span>
            }
            else
            {
                <span>Αποθήκευση</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // Παίρνουμε το κουπόνι κεντρικά πλέον από τα AppDtos
    [Parameter] public CouponDto? CouponToEdit { get; set; }

    private CouponCreateDto _model = new();
    private bool _isSaving = false;
    private bool IsEdit => CouponToEdit != null; // Ελέγχουμε αν είναι Edit Mode

    protected override void OnInitialized()
    {
        if (IsEdit && CouponToEdit != null)
        {
            // Γεμίζουμε τα πεδία με τα υπάρχοντα δεδομένα
            _model = new CouponCreateDto
            {
                Code = CouponToEdit.Code,
                DiscountType = CouponToEdit.DiscountType,
                DiscountValue = CouponToEdit.DiscountValue,
                MinimumSubTotalRequired = CouponToEdit.MinimumSubTotalRequired,
                StartDate = CouponToEdit.StartDate,
                EndDate = CouponToEdit.EndDate,
                IsActive = CouponToEdit.IsActive
            };
        }
        else
        {
            // Προεπιλογές για ΝΕΟ κουπόνι
            _model.StartDate = DateTime.Today;
            _model.EndDate = DateTime.Today.AddDays(30);
            _model.DiscountType = "Percentage";
            _model.IsActive = true;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.Code))
        {
            Snackbar.Add("Ο κωδικός είναι υποχρεωτικός.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            HttpResponseMessage response;

            var payload = new
            {
                Code = _model.Code,
                DiscountType = _model.DiscountType,
                DiscountValue = _model.DiscountValue,
                MinimumSubTotalRequired = _model.MinimumSubTotalRequired,
                StartDate = _model.StartDate?.ToString("yyyy-MM-dd"),
                EndDate = _model.EndDate?.ToString("yyyy-MM-dd"),
                IsActive = _model.IsActive
            };

            if (IsEdit)
            {
                // PUT REQUEST μέσω του Service. Τα TenantId και Token μπαίνουν αυτόματα.
                response = await CouponService.UpdateCouponAsync(CouponToEdit!.Id, payload);
            }
            else
            {
                // POST REQUEST μέσω του Service.
                response = await CouponService.CreateCouponAsync(payload);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(IsEdit ? "Το κουπόνι ενημερώθηκε επιτυχώς!" : "Το κουπόνι δημιουργήθηκε επιτυχώς!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Αποτυχία: {errorMsg}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}