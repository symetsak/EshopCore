@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@inject IUserService UserService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
            Ιστορικό Παρατηρήσεων: @Username
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="max-height: 400px; overflow-y: auto; background-color: var(--mud-palette-background-grey);">
            @if (_notes.Any())
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (var note in _notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <ItemContent>
                                <div class="d-flex align-center mb-1">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold mr-2">
                                        @note.CreatedBy
                                    </MudText>

                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        • @DateTime.SpecifyKind(note.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM HH:mm")
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">
                                    @note.Content
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="text-muted text-center py-4">Δεν υπάρχουν παρατηρήσεις για αυτόν τον χρήστη.</MudText>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Κλείσιμο</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int UserId { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;

    private List<UserNoteDto> _notes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Η κλήση γίνεται πλέον μέσα από το Service! Όλα τα headers μπαίνουν αυτόματα από τον Handler.
            _notes = await UserService.GetUserNotesAsync(UserId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα φόρτωσης παρατηρήσεων: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}