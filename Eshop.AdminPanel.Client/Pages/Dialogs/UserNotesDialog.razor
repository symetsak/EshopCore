@using System.Net.Http.Headers
@using System.Net.Http.Json
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
            Ιστορικό Παρατηρήσεων: @Username
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="max-height: 400px; overflow-y: auto; background-color: var(--mud-palette-background-grey);">
            @if (_notes.Any())
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (var note in _notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <ItemContent>
                                <div class="d-flex align-center mb-1">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold mr-2">
                                        @note.CreatedBy
                                    </MudText>

                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        • @DateTime.SpecifyKind(note.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM HH:mm")
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">
                                    @note.Content
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="text-muted text-center py-4">Δεν υπάρχουν παρατηρήσεις για αυτόν τον χρήστη.</MudText>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Κλείσιμο</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int UserId { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;

    private List<UserNoteDto> _notes = new();

    protected override async Task OnInitializedAsync()
    {
        var request = new HttpRequestMessage(HttpMethod.Get, $"api/Users/{UserId}/notes");
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        var tenantId = await LocalStorage.GetItemAsync<string>("tenantId");

        if (!string.IsNullOrEmpty(token)) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        if (!string.IsNullOrEmpty(tenantId)) request.Headers.Add("X-Tenant-Id", tenantId);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            _notes = await response.Content.ReadFromJsonAsync<List<UserNoteDto>>() ?? new();
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    public class UserNoteDto
    {
        public string Content { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public string CreatedBy { get; set; } = string.Empty;
    }
}