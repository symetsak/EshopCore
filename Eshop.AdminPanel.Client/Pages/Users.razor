@page "/admin/users"
@attribute [Authorize(Roles = "Administrator, Employee")]
@using Eshop.AdminPanel.Client.Models
@using Eshop.AdminPanel.Client.Services
@inject IUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudTable Items="@_users" Hover="true" Striped="true" Elevation="3" Style="border-radius: 12px;" Loading="@_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h5" Class="font-weight-bold mr-4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                Ομάδα Συνεργατών
            </MudText>
            <MudSpacer />

            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.AddComment" OnClick="OpenAddMyNoteDialog" Class="mr-2">
                Δημιουργία Παρατήρησης
            </MudButton>

            @if (_isAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenUserDialog(null)">
                    Νέος Χρήστης
                </MudButton>
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Username</MudTh>
            <MudTh>Ονοματεπώνυμο</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Κινητό</MudTh>
            <MudTh>Ρόλος</MudTh>
            <MudTh>Τελευταία Παρατήρηση</MudTh>
            <MudTh Style="text-align: right;">Ενέργειες</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Username"><b>@context.Username</b></MudTd>
            <MudTd DataLabel="Ονοματεπώνυμο">@context.FirstName @context.LastName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Κινητό">
                @(string.IsNullOrEmpty(context.PhoneNumber) ? "-" : context.PhoneNumber)
            </MudTd>
            <MudTd DataLabel="Ρόλος">
                <MudChip T="string" Color="@(context.Role == "Administrator" ? Color.Warning : Color.Info)" Size="Size.Small" Variant="Variant.Text">
                    @context.Role
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Τελευταία Παρατήρηση">
                @if (!string.IsNullOrEmpty(context.LatestNote))
                {
                    <div class="d-flex flex-column">
                        <MudTooltip Text="@context.LatestNote" Placement="Placement.Top" Color="Color.Dark">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;">
                                "@context.LatestNote"
                            </MudText>
                        </MudTooltip>

                        @if (context.LatestNoteCreatedAt.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.75rem;" Class="mt-1">
                                @DateTime.SpecifyKind(context.LatestNoteCreatedAt.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </MudText>
                        }
                    </div>
                }
                else
                {
                    <span class="mud-text-secondary"><i>-</i></span>
                }
            </MudTd>
            <MudTd DataLabel="Ενέργειες" Style="text-align: right;">
                <MudTooltip Text="Παρατηρήσεις / Ιστορικό">
                    <MudIconButton Icon="@Icons.Material.Filled.SpeakerNotes" Color="Color.Success" OnClick="() => OpenNotesDialog(context)" />
                </MudTooltip>

                @if (_isAdmin)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="() => OpenUserDialog(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => ConfirmDelete(context)" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4 text-center">Δεν βρέθηκαν χρήστες ή υπήρξε σφάλμα φόρτωσης.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<UserClientDto> _users = new();
    private bool _loading = false;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        // Ελέγχουμε τον ρόλο του χρήστη που έχει κάνει login!
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Administrator");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUsersAsync();
        }
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        try
        {
            // Κλήση μέσω του UserService
            _users = await UserService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Σφάλμα Σύνδεσης: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenUserDialog(UserClientDto? user)
    {
        var parameters = new DialogParameters { ["UserToEdit"] = user };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<UserDialog>("", parameters, options);
        var result = await dialog.Result;

        if (dialog != null && result != null && !result.Canceled)
        {
            await LoadUsersAsync();
        }
    }

    private async Task ConfirmDelete(UserClientDto user)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Είστε σίγουροι ότι θέλετε να διαγράψετε τον χρήστη '{user.Username}';");

        if (confirmed)
        {
            try
            {
                // Κλήση μέσω του UserService
                var response = await UserService.DeleteUserAsync(user.Id);

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Ο χρήστης διαγράφηκε με επιτυχία!", Severity.Success);
                    await LoadUsersAsync();
                }
                else
                {
                    Snackbar.Add("Αποτυχία διαγραφής.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Σφάλμα: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenNotesDialog(UserClientDto user)
    {
        var parameters = new DialogParameters { ["UserId"] = user.Id, ["Username"] = user.Username };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<UserNotesDialog>("", parameters, options);
        var result = await dialog.Result;

        if (dialog != null && result != null && !result.Canceled)
        {
            await LoadUsersAsync(); // Κάνουμε refresh για να φανεί η νέα 'Τελευταία Παρατήρηση' στον πίνακα
        }
    }

    private async Task OpenAddMyNoteDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddMyNoteDialog>("", options);
        var result = await dialog.Result;

        if (dialog != null && result != null && !result.Canceled)
        {
            await LoadUsersAsync(); // Ανανεώνουμε τον πίνακα μόλις μπει η νέα σημείωση!
        }
    }
}