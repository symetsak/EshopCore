@inherits LayoutComponentBase

<div class="d-flex">
    <!-- Το Sidebar που μόλις φτιάξαμε -->
    <NavMenu />

    <!-- Ο κύριος χώρος που θα φορτώνουν οι σελίδες (Home, Tenants, κλπ) -->
    <main class="flex-grow-1 bg-light" style="min-height: 100vh; overflow-y: auto;">

        <!-- Μια μικρή λευκή μπάρα (Topbar) για ομορφιά και "αναπνοή" -->
        <header class="bg-white shadow-sm px-4 py-3 mb-4 d-flex justify-content-between align-items-center">
            <h5 class="m-0 text-muted fw-light">Super Admin Workspace</h5>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">
                    <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> System Online
                </span>
            </div>
        </header>

        <!-- Εδώ "καρφώνει" το Blazor το περιεχόμενο της εκάστοτε σελίδας -->
        <div class="px-4 pb-4">
            @Body
        </div>

    </main>
</div>