@page "/tenants"
@attribute [Authorize]
@using Eshop.SystemPanel.Models
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Πελάτες | Eshop System</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="bi bi-people-fill me-2 text-primary"></i> Λίστα Πελατών (Tenants)</h3>
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-1"></i> Νέος Πελάτης
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center text-muted p-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p>Φόρτωση πελατών...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger m-4 text-center">@errorMessage</div>
        }
        else if (!tenants.Any())
        {
            <div class="text-center text-muted p-5">
                <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                <p>Δεν βρέθηκαν πελάτες στο σύστημα.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Πελάτης</th>
                            <th class="py-3">Επικοινωνία</th>
                            <th class="py-3">Τοποθεσία</th>
                            <th class="py-3">Database</th>
                            <th class="py-3 text-center">Κατάσταση</th>
                            <th class="px-4 py-3 text-end">Ενέργειες</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in tenants)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-dark">@tenant.Name</div>
                                    <div class="text-muted small" style="font-size: 0.8rem;">ID: @tenant.Id</div>
                                </td>

                                <td class="py-3 text-muted small">
                                    <div class="mb-1">
                                        <i class="bi bi-envelope text-secondary me-1"></i>
                                        @(string.IsNullOrWhiteSpace(tenant.Email) ? "-" : tenant.Email)
                                    </div>
                                    <div>
                                        <i class="bi bi-telephone text-secondary me-1"></i>
                                        @(string.IsNullOrWhiteSpace(tenant.Mobile) ? "-" : tenant.Mobile)
                                    </div>
                                </td>

                                <td class="py-3 text-muted small">
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt text-secondary me-1"></i>
                                        @(string.IsNullOrWhiteSpace(tenant.City) ? "-" : tenant.City)
                                    </div>
                                    <div>
                                        @(string.IsNullOrWhiteSpace(tenant.Address) ? "" : tenant.Address)
                                    </div>
                                </td>

                                <td class="py-3 text-muted small">
                                    @(string.IsNullOrEmpty(tenant.ConnectionString) ? "-" : "Ρυθμισμένο")
                                </td>

                                <td class="py-3 text-center">
                                    @if (tenant.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">Ενεργός</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3">Ανενεργός</span>
                                    }
                                </td>

                                <td class="px-4 py-3 text-end">
                                    <button class="btn btn-sm btn-light border text-primary me-2" title="Επεξεργασία" @onclick="() => OpenEditModal(tenant)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button class="btn btn-sm @(tenant.IsActive ? "btn-light border text-warning" : "btn-light border text-success")"
                                            title="Αλλαγή Κατάστασης (Suspend)"
                                            @onclick="() => ToggleTenantStatus(tenant)"
                                            disabled="@isToggling">
                                        <i class="bi @(tenant.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showCreateModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Νέος Πελάτης</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseCreateModal"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="alert alert-danger small py-2">@createErrorMessage</div>
                    }

                    <EditForm Model="createModel" OnValidSubmit="CreateTenant">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Tenant ID (π.χ. eshop-1) *</label>
                                <InputText @bind-Value="createModel.Id" class="form-control bg-light" required />
                                <div class="form-text small">Προσοχή: Αυτό δεν αλλάζει ποτέ αργότερα.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Όνομα (Επωνυμία) *</label>
                                <InputText @bind-Value="createModel.Name" class="form-control bg-light" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Connection String *</label>
                            <InputText @bind-Value="createModel.ConnectionString" class="form-control bg-light" required placeholder="Host=...;Database=...;Username=...;Password=..." />
                        </div>

                        <hr class="text-secondary" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Email</label>
                                <InputText @bind-Value="createModel.Email" type="email" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Κινητό</label>
                                <InputText @bind-Value="createModel.Mobile" class="form-control bg-light" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Πόλη</label>
                                <InputText @bind-Value="createModel.City" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Διεύθυνση</label>
                                <InputText @bind-Value="createModel.Address" class="form-control bg-light" />
                            </div>
                        </div>

                        <div class="modal-footer border-top-0 px-0 pb-0 mt-3">
                            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseCreateModal">Ακύρωση</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4" disabled="@isCreating">
                                @if (isCreating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Δημιουργία...</span>
                                }
                                else
                                {
                                    <span>Δημιουργία</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Επεξεργασία Πελάτη</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditModal"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="editModel" OnValidSubmit="SaveChanges">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Όνομα Πελάτη *</label>
                            <InputText @bind-Value="editModel.Name" class="form-control form-control-lg bg-light" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Email</label>
                                <InputText @bind-Value="editModel.Email" type="email" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Κινητό</label>
                                <InputText @bind-Value="editModel.Mobile" class="form-control bg-light" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Πόλη</label>
                                <InputText @bind-Value="editModel.City" class="form-control bg-light" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small fw-bold text-secondary">Διεύθυνση</label>
                                <InputText @bind-Value="editModel.Address" class="form-control bg-light" />
                            </div>
                        </div>

                        <div class="modal-footer border-top-0 px-0 pb-0 mt-3">
                            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseEditModal">Ακύρωση</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Αποθήκευση...</span>
                                }
                                else
                                {
                                    <span>Αποθήκευση</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TenantModel> tenants = new();
    private bool isLoading = true;
    private bool isToggling = false;
    private string? errorMessage;

    // --- Μεταβλητές για το Modal Επεξεργασίας ---
    private bool showEditModal = false;
    private bool isSaving = false;
    private UpdateTenantDetailsDto editModel = new();
    private string? editingTenantId;

    // --- ΝΕΕΣ Μεταβλητές για το Modal Δημιουργίας ---
    private bool showCreateModal = false;
    private bool isCreating = false;
    private CreateTenantDto createModel = new();
    private string? createErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // 1. Διαβάζουμε το Token από το LocalStorage
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            // 2. Το βάζουμε στο Header του Http Client
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            // 3. Τώρα κάνουμε την κλήση με ασφάλεια!
            var response = await Http.GetAsync("api/Tenants");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<TenantModel>>();
                if (result != null)
                {
                    tenants = result;
                }
            }
            else
            {
                errorMessage = $"Αποτυχία φόρτωσης. Status Code: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Σφάλμα επικοινωνίας με το API.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleTenantStatus(TenantModel tenant)
    {
        if (isToggling) return;

        isToggling = true;
        try
        {
            // Επειδή έχουμε AuthHeader globally, κάνουμε απευθείας το Patch
            var response = await Http.PatchAsync($"api/Tenants/{tenant.Id}/toggle-status", null);

            if (response.IsSuccessStatusCode)
            {
                // Αντιστρέφουμε οπτικά το status χωρίς να ξαναφορτώσουμε όλη τη λίστα!
                tenant.IsActive = !tenant.IsActive;
            }
            else
            {
                errorMessage = "Απέτυχε η αλλαγή κατάστασης.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Σφάλμα κατά την αλλαγή κατάστασης.";
        }
        finally
        {
            isToggling = false;
        }
    }

    private void OpenEditModal(TenantModel tenant)
    {
        // 1. Κρατάμε το ID του πελάτη που επεξεργαζόμαστε
        editingTenantId = tenant.Id;

        // 2. Αντιγράφουμε τα τωρινά του στοιχεία στη Φόρμα (DTO)
        editModel = new UpdateTenantDetailsDto
        {
            Name = tenant.Name,
            Email = tenant.Email,
            Mobile = tenant.Mobile,
            City = tenant.City,
            Address = tenant.Address
        };

        // 3. Εμφανίζουμε το Modal
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingTenantId = null;
    }

    private async Task SaveChanges()
    {
        if (string.IsNullOrEmpty(editingTenantId) || isSaving) return;

        isSaving = true;
        try
        {
            // Στέλνουμε το PUT request στο API (το Token υπάρχει ήδη στον Http Client από το LoadTenants)
            var response = await Http.PutAsJsonAsync($"api/Tenants/{editingTenantId}", editModel);

            if (response.IsSuccessStatusCode)
            {
                // Αντί να ξαναφορτώσουμε ΟΛΟΥΣ τους πελάτες από το API,
                // ενημερώνουμε απλά τον 1 πελάτη στη λίστα μας για να είναι ακαριαίο!
                var tenantInList = tenants.FirstOrDefault(t => t.Id == editingTenantId);
                if (tenantInList != null)
                {
                    tenantInList.Name = editModel.Name;
                    tenantInList.Email = editModel.Email;
                    tenantInList.Mobile = editModel.Mobile;
                    tenantInList.City = editModel.City;
                    tenantInList.Address = editModel.Address;
                }

                CloseEditModal(); // Κλείνουμε το παραθυράκι
            }
            else
            {
                errorMessage = "Απέτυχε η αποθήκευση των στοιχείων.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Σφάλμα επικοινωνίας κατά την αποθήκευση.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenCreateModal()
    {
        createModel = new CreateTenantDto(); // Καθαρίζουμε τη φόρμα
        createErrorMessage = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateTenant()
    {
        if (isCreating) return;
        isCreating = true;
        createErrorMessage = null;

        try
        {
            // Κάνουμε POST στο API
            var response = await Http.PostAsJsonAsync("api/Tenants", createModel);

            if (response.IsSuccessStatusCode)
            {
                // Αν πετύχει, κλείνουμε το modal και επαναφορτώνουμε όλη τη λίστα
                CloseCreateModal();
                await LoadTenants();
            }
            else
            {
                // Το API σου επιστρέφει string σε περίπτωση Conflict/BadRequest (π.χ. "Το ID υπάρχει ήδη")
                var errorText = await response.Content.ReadAsStringAsync();
                createErrorMessage = $"Απέτυχε η δημιουργία: {errorText}";
            }
        }
        catch (Exception)
        {
            createErrorMessage = "Σφάλμα επικοινωνίας κατά τη δημιουργία.";
        }
        finally
        {
            isCreating = false;
        }
    }
}